# Euka environment — copy to `.env` and fill in. Loaded by server.mjs via
# process.loadEnvFile(). NEVER commit the real .env.

# Anthropic API key — required for evaluation, JD enrichment, draft/CV
# generation. Can also be set at runtime via Settings → Integrations
# (persisted to data/config.json).
ANTHROPIC_API_KEY=

# Google OAuth (optional) — only needed for Google Docs resume sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server port (defaults to 8000; the `dev` script overrides to 4568).
PORT=4568
