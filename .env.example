# Euka environment — copy to `.env` and fill in. Loaded by server.mjs via
# process.loadEnvFile(). NEVER commit the real .env.

# ── LLM backend ──────────────────────────────────────────────────────────
# Pick ONE of the two options below.
#
# Option A (no API key): use the local `claude` CLI (Claude Code
# subscription). Uncomment the line below; `claude` must be on PATH in the
# shell that runs the server. No ANTHROPIC_API_KEY needed.
#   Caveat: Stage B evaluator's local tool-use (job-legitimacy verify)
#   degrades to a single round in CLI mode — web search still happens inside
#   the CLI turn. Everything else (Stage A, open-question fill, induction,
#   CV tailor) is unaffected.
# CAREER_LLM_BACKEND=cli
#
# Option B (API key): required for evaluation, JD enrichment, draft/CV
# generation. Can also be set at runtime via Settings → Integrations
# (persisted to data/config.json).
ANTHROPIC_API_KEY=

# Google OAuth (optional) — only needed for Google Docs resume sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server port (defaults to 8000; the `dev` script overrides to 4568).
PORT=4568
